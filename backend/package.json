{
  "name": "reachinbox-scheduler-backend",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/queue/worker.ts",
    "build": "prisma generate && tsc -p .",
    "start": "node dist/index.js",
    "start:worker": "node dist/queue/worker.js",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "senders:create": "tsx scripts/createEtherealSenders.ts",
    "loadtest": "tsx scripts/loadTest.ts"
  },
  "dependencies": {
    "@bull-board/api": "^5.20.0",
    "@bull-board/express": "^5.20.0",
    "@elastic/elasticsearch": "^8.13.1",
    "@prisma/client": "^5.15.0",
    "bullmq": "^5.7.15",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sanitize-html": "^2.17.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^6.4.15",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/sanitize-html": "^2.16.1",
    "prisma": "^5.15.0",
    "tsx": "^4.15.4",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
