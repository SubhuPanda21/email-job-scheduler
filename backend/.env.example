# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=change-me-super-secret
JWT_SECRET=change-me-jwt-secret

# --- Postgres (via Prisma) ---
DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5432/reachinbox"

# --- Redis (BullMQ + rate limit counters) ---
REDIS_URL=redis://localhost:6379

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# --- Ethereal SMTP (fake SMTP for testing) ---
# Get these from https://ethereal.email/create — one set per "sender" you want to simulate
ETHEREAL_SMTP_HOST=smtp.ethereal.email
ETHEREAL_SMTP_PORT=587
ETHEREAL_SENDERS=sender1@ethereal.email:pass1,sender2@ethereal.email:pass2

# --- Rate limiting / throughput (all configurable, no hardcoding) ---
# MIN_DELAY is a floor per sender; MAX_EMAILS_PER_HOUR is the default shown in the Compose form
# (each batch can override it from the UI). Limits are enforced per sender in Redis.
WORKER_CONCURRENCY=5
MIN_DELAY_MS_BETWEEN_SENDS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Slack OAuth (for rate-limit notifications) ---
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
